{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.monday/monday.py\" hook session-start --platform claude", "timeout": 30}]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.monday/monday.py\" hook pre --platform claude", "timeout": 30}]
      }
    ],
    "Stop": [
      {
        "hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.monday/monday.py\" hook stop --platform claude", "timeout": 900}]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/.monday/monday.py\" hook stop --platform claude", "timeout": 900}]
      }
    ]
  }
}
