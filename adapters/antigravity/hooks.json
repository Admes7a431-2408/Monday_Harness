{
  "monday": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 ../.monday/monday.py hook session-start --platform antigravity",
        "timeout": 30
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ../.monday/monday.py hook pre --platform antigravity",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 ../.monday/monday.py hook stop --platform antigravity",
        "timeout": 900
      }
    ]
  }
}
